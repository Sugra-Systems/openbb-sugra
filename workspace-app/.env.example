# Copy to .env and fill in. The backend reads these at startup.

# Sugra API base URL (default is production).
SUGRA_API_BASE=https://sugra.ai

# Sugra API key. Required for every widget except "Sanctions & PEP Coverage".
# Get one at https://sugra.ai
SUGRA_API_KEY=

# Optional: upstream HTTP timeout in seconds (default 30).
# SUGRA_HTTP_TIMEOUT=30
